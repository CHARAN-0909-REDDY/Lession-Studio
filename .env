# Create a key in Google AI Studio on a free-tier project with no billing account linked.
# Keep this file local as .env. Never paste the key into frontend code or commit it.
GEMINI_API_KEY=
# Optional no-cost fallback. Use a Groq Free Plan key; the app never upgrades the account.
GROQ_API_KEY=
# Optional free-only fallback; app calls OpenRouter's openrouter/free route, never paid model IDs.
OPENROUTER_API_KEY=
# Optional: enables automatic YouTube video discovery. Use a project with no billing account linked.
YOUTUBE_API_KEY=
# Optional contact URL or email included in requests to Wikimedia, as requested by its API policy.
WIKIMEDIA_CONTACT=
